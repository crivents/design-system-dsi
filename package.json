    "prettier": "^3.7.1",
    "playwright": "latest",
    "storybook": "^10.5.9",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "latest"
  }
